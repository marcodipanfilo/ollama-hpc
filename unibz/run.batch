#!/bin/bash
#SBATCH --job-name=ollama
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=100G
#SBATCH --time=05:00:00
#SBATCH --gres=gpu:1
#SBATCH --constraint=gpu32g
#SBATCH --account=vkg_mpboot
#SBATCH --partition=gpu-pre
#SBATCH --output=logs/%j.out
#SBATCH --error=logs/%j.err

module load cuda

export OLLAMA_BIN="$HOME/opt/ollama-0.17.7/bin/ollama"

hostname > "$HOME/ollama-hpc/unibz/nodename.txt"

export GIN_MODE=release
export OLLAMA_HOST=0.0.0.0:11434
export OLLAMA_MODELS=/data/users/mdipanfilo/ollama
export OLLAMA_DEBUG=1
export OLLAMA_NUM_PARALLEL=1
export OLLAMA_MAX_LOADED_MODELS=1
export OLLAMA_CONTEXT_LENGTH=2048

echo "=== HOST ==="
hostname
echo "=== OLLAMA BIN ==="
echo "$OLLAMA_BIN"
"$OLLAMA_BIN" --version
echo "=== NVIDIA-SMI ==="
nvidia-smi

"$OLLAMA_BIN" serve
